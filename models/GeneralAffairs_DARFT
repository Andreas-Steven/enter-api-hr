                    'created_at'        => $this->timestamp,
                    'created_by'        => Yii::$app->session->get('username'),
                    'updated_at'        => null,
                    'updated_by'        => null,
                    'deleted_at'        => null,
                    'deleted_by'        => null
                ]
            ];
            $this->item = [
                'items' => [
                    '0' => [
                        'barcode'           => $data['barcode'],
                        // 'image'             => ($picture == null) ? [] : [$picture],
                        'image'             => [],
                        'price'             => floatval($data['price']),
                        'category' => [
                            'id'            => $data['category_id'],
                            'name'          => $this->getCategoryName($data['category_id']),
                        ],
                        'location' => [
                            'id'            => $data['location_id'],
                            'name'          => $this->getLocationName($data['location_id']),
                        ],
                        'department' => [
                            'id'            => $data['department_id'],
                            'name'          => $this->getDepartmentName($data['department_id']),
                        ],
                        'condition'         => $data['condition'],
                        'inspection_date'   => ($data['inspection_date'] == '') ? null : $data['inspection_date'],
                        'tax_date'          => ($data['tax_date'] == '') ? null : $data['tax_date'],
                        'description'       => $data['description'],
                        'item_change_log' => [
                            'created_at'    => $this->timestamp,
                            'created_by'    => Yii::$app->session->get('username'),
