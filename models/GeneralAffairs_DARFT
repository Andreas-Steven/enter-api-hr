    public function getAll()
    {
        // SELECT elemen.key AS index, elemen.value AS item
        // FROM public.ga
        // CROSS JOIN LATERAL jsonb_each(item->'items') AS elemen
        // WHERE elemen.value->>'deleted_at' IS NULL LIMIT 1;

        $query = self::find()
            ->select('elemen.key AS index, elemen.value AS item')
            ->from('public.ga')
            ->join('CROSS JOIN', 'LATERAL jsonb_each(item->\'items\') AS elemen')
            ->where('elemen.value->>\'deleted_at\' IS NULL LIMIT 1');
        
        return $query->one();
    }

    public function show($barcode)
    {
        $query = self::find()
            ->select('elemen.key AS index, elemen.value AS item')
            ->from('public.ga')
            ->join('CROSS JOIN', 'LATERAL jsonb_each(item->\'items\') AS elemen')
            ->where('elemen.value->>\'barcode\' = :barcode AND elemen.value->>\'deleted_at\' IS NULL')
            ->params([':barcode' => $barcode]);
        
        return $query->one();
    }

    public function beforeSave($insert)
    {
