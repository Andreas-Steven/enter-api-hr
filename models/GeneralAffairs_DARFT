                        ]
                    ],
                    'quantity'              => 1,
                    'total_price'           => floatval($data['price'])
                ]
            ];
        } 

        return parent::beforeSave($insert);
    }

    public function upsert()
    {   
        $existing = $this->find()->where(['name' => $this->name])->one();
        $data = Yii::$app->request->post();
        $item = $existing->item;
        $newId = 1;
        $check = false;
        

        foreach ($item['items']  as $key => $value) {
            $newId++;
            if (is_array($value) && array_key_exists('barcode', $value)) {
                if($value['barcode'] == $data['barcode']) {
                    $check = true;
                }
            }
        }

        if($existing && !$check) {
            $newItem[$newId] = [
                'barcode'           => $data['barcode'],
                // 'image'          => ($picture == null) ? [] : [$picture],
                'image'             => [],
                'price'             => floatval($data['price']),
                'category' => [
                    'id'            => $data['category_id'],
                    'name'          => $this->getCategoryName($data['category_id']),
                ],
                'location' => [
                    'id'            => $data['location_id'],
                    'name'          => $this->getLocationName($data['location_id']),
                ],
                'condition'         => $data['condition'],
                'department'        => [
                    'id'            => $data['department_id'],
                    'name'          => $this->getDepartmentName($data['department_id']),
                ],
                'description'       => $data['description'],
                'item_change_log' => [
                    'created_at'    => $this->timestamp,
                    'created_by'    => Yii::$app->session->get('username'),
                    'deleted_at'    => null,
                    'deleted_by'    => null,
                    'updated_by'    => null,
                ]
            ];

            $newData = array_merge($item['items'], $newItem);
            $detailInfo = $existing->detail_info;
            $detailInfo['change_log']['updated_at'] = $this->timestamp;
            $detailInfo['change_log']['updated_by'] = Yii::$app->session->get('username');
            $existing->detail_info = $detailInfo;

            $total_price = $qty = 0;
            foreach ($newData as $key => $value) {
                if (is_array($value) && array_key_exists('price', $value)) {
                    if($value['item_change_log']['deleted_at'] == null) {
                        $total_price += $value['price'];
                        $qty++;
                    }
                }
            }

            $newData['quantity'] = $qty;
            $newData['total_price'] = $total_price;

            $existing->updateAttributes([
                'item' => [
                    'items' => $newData
                ],
                'detail_info' => $existing->detail_info
            ]);

            return $existing->save();
        }

        return false;
    }

    public function updateData()
    {   
        $data = Yii::$app->request->post();
        $model = $this->findOne($data['id']);
        $items = $model->item['items'];
        $index = $data['index'];
        
        if (isset($items[$index])) {
            $items[$index] = [
                'barcode'           => $data['barcode'],
                'image'             => [],
                'price'             => $data['price'],
                'category' => [
                    'id'            => $data['category_id'],
                    'name'          => $data['category_name']
                ],
                'location' => [
                    'id'            => $data['location_id'],
                    'name'          => $data['location_name']
                ],
                'department' => [
                    'id'            => $data['department_id'],
                    'name'          => $data['department_name']
                ],
                'condition'         => $data['condition'],
                'description'       => $data['description'],
                'item_change_log' => [
                    'created_at'    => $items[$index]['item_change_log']['created_at'],
                    'created_by'    => $items[$index]['item_change_log']['created_by'],
                    'deleted_at'    => ($items[$index]['item_change_log']['deleted_at'] == null) ? '' : $items[$index]['item_change_log']['deleted_at'],
                    'deleted_by'    => ($items[$index]['item_change_log']['deleted_by'] == null) ? '' : $items[$index]['item_change_log']['deleted_by'],
                    'updated_at'    => $this->timestamp,
                    'updated_by'    => Yii::$app->session->get('username'),
                ]
            ];  
    
            $total_price = $qty = 0;
            foreach ($items as $key => $value) {
                if (is_array($value) && array_key_exists('price', $value)) {
                    if($value['item_change_log']['deleted_at'] == null) {
                        $total_price += $value['price'];
                        $qty++;
                    }
                }
            }
    
            $detailInfo = $model->detail_info;
            $detailInfo['change_log']['updated_at'] = $this->timestamp;
            $detailInfo['change_log']['updated_by'] = Yii::$app->session->get('username');
            $model->detail_info = $detailInfo;
    
            $items['quantity'] = $qty;
            $items['total_price'] = $total_price;
    
            $model->updateAttributes([
                'item' => [
                    'items' => $items,
                ],
                'detail_info' => $model->detail_info
            ]);
    
            return $model->save();
        }

        return false;
    }

    public function softDelete()
    {
        $model = $this->getAttribute('item')['items'];
        $item = $this->getAttribute('item')['items'];
        $index = 0;

        foreach ($item as $key => $value) {
            if (is_array($value) && array_key_exists('barcode', $value)) {
                if ($value['barcode'] == Yii::$app->request->post('barcode') && $value['item_change_log']['deleted_at'] == null) {
                    $index = $key;
                    break;
                } else {
                    $index = null;
                }
            }
        }
        
        if ($index !== null) {
            $item_change_log = $item[$index]['item_change_log'];
            $item_change_log['deleted_at'] = $this->timestamp;
            $item_change_log['deleted_by'] = Yii::$app->session->get('username');
            $item[$index]['item_change_log'] = $item_change_log;
    
            $detailInfo = $this->detail_info;
            $detailInfo['change_log']['updated_at'] = $this->timestamp;
            $detailInfo['change_log']['updated_by'] = Yii::$app->session->get('username');
            $this->detail_info = $detailInfo;

            $total_price = $qty = 0;
            foreach ($item as $key => $value) {
                if (is_array($value) && array_key_exists('price', $value)) {
                    if($value['item_change_log']['deleted_at'] == null) {
                        $total_price += $value['price'];
                        $qty++;
                    }
                }
            }

            $item['quantity'] = $qty;
            $item['total_price'] = $total_price;
    
            return $this->updateAttributes([
                'item' => [
                    'items' => $item
                ],
                'detail_info' => $this->detail_info,
            ]);
        } 
        
        return false;
    }   
